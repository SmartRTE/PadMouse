# 默认：文本文件入库统一用 LF，检出时按平台转换
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则在 cmd 里跑不起来
*.bat text eol=crlf

# 二进制，禁止任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.so binary

# Gradle wrapper 的 jar 也当二进制
gradle/wrapper/gradle-wrapper.jar binary
